<?xml version="1.0" encoding="utf-8"?>
<!--
  Backing view for the Home video background. A texture_view surface (not the
  default surface_view) is used so the Compose scrim and UI compose cleanly on
  top of the video; resize_mode=zoom center-crops the footage to fill.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom"
    app:shutter_background_color="#FF0B0E13" />
