<?xml version="1.0" encoding="UTF-8"?>
<!--
    Declaring android:appCategory="game" (see AndroidManifest.xml) also opts Hawkeye into
    Game Mode, where OEMs may apply their own interventions unasked. Two of them would
    quietly degrade the renderer: downscaling drops the GL resolution, and the FPS override
    caps the frame rate the replay clock is paced against. Both are refused here.

    Only the intervention opt-outs are declared. supportsBatteryGameMode /
    supportsPerformanceGameMode are deliberately absent: declaring either is a promise that
    the app implements its own optimization for that mode, and Hawkeye implements none.
-->
<game-mode-config
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:allowGameDownscaling="false"
    android:allowGameFpsOverride="false" />
